# Dependencies
node_modules/

# Build outputs
dist/
.next/
.turbo/

# Environment files — scripts/local/setup.mjs generates these automatically with real secrets.
# Never commit them. Committed *.env.example files are the templates; those stay tracked.
.env
.env.local
**/.env
**/.env.local
!**/.env.example

# Puppeteer's local browser cache (apps/api/.puppeteerrc.cjs)
.cache/

# Editor / OS
.DS_Store
*.log
.vscode/
.idea/
