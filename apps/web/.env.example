# Base URL of the Fastify API (Better Auth is mounted at /api/auth/*)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Product analytics (M5 P5.4) — PostHog. Create a free project at posthog.com to get a key.
# Until NEXT_PUBLIC_POSTHOG_KEY is set, analytics calls silently no-op (see lib/analytics.ts).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The site's real public URL — drives metadataBase (so Open Graph/Twitter image URLs resolve to
# real absolute links), sitemap.xml, and robots.txt's Sitemap: line. Defaults to
# https://growthos.app if unset, which is almost certainly wrong for your deployment — set this
# to your actual domain before launch, or social share previews and the sitemap will point at a
# domain you don't own.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
