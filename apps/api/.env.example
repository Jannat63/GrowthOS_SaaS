# Fastify API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Neon Postgres (same connection string as packages/db)
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require

# Better Auth
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Platform integrations / OAuth (M3 P3.0)
# 32-byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=
# From Google Cloud (APIs & Services → Credentials → OAuth client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/oauth/callback
# Local dev databases (worker/analytics)
CLICKHOUSE_URL=http://localhost:8123
REDIS_URL=redis://localhost:6379

# Stripe billing (M5 P5.1)
# 1. Create a Stripe account (dashboard.stripe.com) in test mode, get your API keys.
# 2. Create 3 Products with recurring Prices matching the blueprint's plans
#    (Starter $79/mo, Growth $199/mo, Scale $399/mo) — note each Price ID below.
# 3. Create a webhook endpoint pointing to <api origin>/api/v1/billing/webhook, subscribed to at
#    least: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted. Set STRIPE_WEBHOOK_SECRET from that endpoint.
# Until STRIPE_SECRET_KEY is set, /billing/checkout returns INTEGRATION_NOT_CONNECTED (409)
# instead of crashing — nothing else in the app depends on Stripe being configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Resend lifecycle emails (M5 P5.3) — trial-ending / dunning / trial-converted. Receipts are NOT
# built here — turn on Stripe's own customer emails (Dashboard → Settings → Customer emails)
# instead. Until RESEND_API_KEY is set, emails silently no-op rather than crashing anything.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Error monitoring. Off unless SENTRY_DSN is set, and the SDK is deliberately NOT a dependency —
# set the DSN, then run `pnpm --filter @growthos/api add @sentry/node`. With the DSN set and the
# package missing, boot warns and carries on with logs only. Reports unexpected 500s, failures in
# the unattended scheduler tasks, unhandled rejections, and uncaught exceptions.
# SENTRY_RELEASE is optional and only tags reports with a build identifier.
SENTRY_DSN=
SENTRY_RELEASE=

# Retries on transient Neon failures (see packages/db/src/retry.ts). Default 2; set 0 to disable.
DB_MAX_RETRIES=

# Optional. Core Web Vitals (real feature, apps/api/src/core-web-vitals.ts) works without this —
# Google's PageSpeed Insights API accepts keyless requests. Add a free key (no billing account
# needed) at https://developers.google.com/speed/docs/insights/v5/get-started only if you hit its
# lower keyless rate limit.
GOOGLE_PAGESPEED_API_KEY=
